{
  "name": "nuxt-lightbox",
  "version": "0.1.0",
  "description": "A modern, typed, SSR-safe lightbox module for Nuxt 3/4",
  "type": "module",
  "license": "MIT",
  "author": "Michael Eder",
  "homepage": "https://github.com/MichaelEder1/nuxt-lightbox#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelEder1/nuxt-lightbox.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelEder1/nuxt-lightbox/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "lightbox",
    "gallery",
    "vue",
    "image-viewer",
    "video-player"
  ],
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "node scripts/prepare-root-types.mjs",
    "build": "nuxt-module-build build",
    "prepack": "npm run build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "node scripts/prepare-root-types.mjs && nuxt-module-build build && nuxi prepare playground",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "node scripts/prepare-root-types.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nuxt/kit": "^3.13.0 || ^4.0.0"
  },
  "peerDependencies": {
    "nuxt": "^3.13.0 || ^4.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^0.5.0",
    "@nuxt/module-builder": "^0.8.0",
    "@nuxt/schema": "^3.13.0 || ^4.0.0",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.9.0",
    "happy-dom": "^20.11.1",
    "nuxi": "^3.13.0",
    "nuxt": "^3.13.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}
